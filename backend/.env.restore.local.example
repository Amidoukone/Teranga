# Compte d'administration du serveur MySQL LOCAL réservé aux copies de restauration.
# Le script ignore DATABASE_URL, refuse les hôtes distants et les bases existantes.
# Le mot de passe doit être encodé pour une URL ; aucun identifiant réel ici.
RESTORE_DATABASE_URL=mysql://root:replace-with-local-password@127.0.0.1:3306/
