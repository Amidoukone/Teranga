NODE_ENV=production
PORT=10000

# Security
JWT_SECRET=replace-with-strong-secret-min-32-chars
CORS_ORIGINS=https://teranga-diaspora.com,https://www.teranga-diaspora.com
FRONTEND_URL=https://www.teranga-diaspora.com
CLIENT_URL=https://www.teranga-diaspora.com
CLIENT_ORIGIN=https://www.teranga-diaspora.com
METRICS_TOKEN=replace-with-random-token
FRONTEND_ERROR_TOKEN=replace-with-random-token
LOG_LEVEL=info

# Isolation territoriale progressive. Laisser false tant que `npm run data:audit-geo`
# ne retourne pas STRICT MODE READY, puis activer environnement par environnement.
GEO_SCOPE_STRICT_MODE=false

# Mobility operations: driver acceptance window (2 to 15 minutes, default 300 seconds).
MISSION_ACCEPTANCE_WINDOW_SECONDS=300

# Bootstrap admin policy (production-safe defaults)
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_ALLOW_DEFAULTS=false
BOOTSTRAP_ADMIN_EXPIRES_AT=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DEFAULT_EMAIL=
BOOTSTRAP_ADMIN_DEFAULT_PASSWORD=

# Database
DATABASE_URL=mysql://user:password@host:3306/database
DB_DIALECT=mysql
DB_TIMEZONE=+00:00
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# If the provider gives a custom CA certificate, set either one:
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# DB_SSL_CA_PATH=/etc/secrets/mysql-ca.pem
# Legacy only during PlanetScale maintenance/export; do not set it on Render after migration.
# PLANETSCALE_DATABASE_URL=mysql://user:password@host:3306/database

# Media
PROPERTY_MAX_FILE_MB=20
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_SECURE=true
# Taille maximale d'une photo/piece chauffeur ou vehicule envoyee depuis la galerie.
MOBILITY_MEDIA_MAX_FILE_MB=10
# Laisser vide en production avec ImageKit. Activer seulement avec un UPLOADS_ROOT persistant.
# MOBILITY_MEDIA_ALLOW_LOCAL_FALLBACK=false

# Google Maps Platform (server-side: Geocoding, Directions, Distance Matrix)
# Restricted by IP in Google Cloud Console (Render outbound IPs) — never the browser key.
GOOGLE_MAPS_SERVER_KEY=
