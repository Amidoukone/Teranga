{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "description": "Teranga API (Express + Sequelize + MySQL)",
  "scripts": {
    "dev": "nodemon index.js",
    "lint": "node scripts/lint.js",
    "validate:prod-config": "node scripts/validate-prod-config.js",
    "data:fix-mojibake": "node scripts/fix-mojibake-data.js --dry-run",
    "data:fix-mojibake:apply": "node scripts/fix-mojibake-data.js --apply",
    "data:fix-mojibake:silent": "node scripts/fix-mojibake-data.js --dry-run --silent",
    "data:fix-mojibake:apply:silent": "node scripts/fix-mojibake-data.js --apply --silent",
    "data:backfill-service-geocoords": "node scripts/backfill-service-geocoords.js --dry-run",
    "data:backfill-service-geocoords:apply": "node scripts/backfill-service-geocoords.js",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate-url": "node scripts/migrate-database-url.js",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:check": "node scripts/check-database.js",
    "db:check-url": "node scripts/check-database-url.js",
    "db:import-dump": "node scripts/import-sql-dump.js",
    "db:import-dump-url": "node scripts/import-dump-url.js",
    "db:import-rehearsal-url": "node scripts/import-dump-url.js --latest-rehearsal",
    "db:import-final-url": "node scripts/import-dump-url.js --latest-final",
    "db:reconcile-migrations": "node scripts/reconcile-migration-state.js",
    "db:do:init": "node scripts/create-digitalocean-db-user.js",
    "render:db-env": "node scripts/prepare-render-db-env.js",
    "db:reset": "npm run db:migrate:undo -- --all && npm run db:migrate && npm run db:seed",
    "db:test:setup": "NODE_ENV=test sequelize-cli db:create && NODE_ENV=test sequelize-cli db:migrate && NODE_ENV=test sequelize-cli db:seed:all",
    "e2e:integration:migrate": "node scripts/e2e-integration-migrate.js",
    "e2e:integration:setup": "node scripts/e2e-integration-setup.js",
    "e2e:integration:server": "node scripts/start-e2e-integration-server.js",
    "test": "node scripts/run-tests.js --runInBand",
    "test:contract": "node scripts/run-tests.js tests/contract --runInBand"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "imagekit": "^6.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.15.0",
    "recharts": "^2.15.4",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "sequelize-cli": "^6.6.3",
    "supertest": "^7.1.1"
  }
}
