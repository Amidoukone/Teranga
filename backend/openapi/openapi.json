{
  "openapi": "3.0.3",
  "info": {
    "title": "Teranga API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Healthcheck",
        "responses": {
          "200": {
            "description": "Service available",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Readiness check",
        "responses": {
          "200": {
            "description": "Service ready to serve traffic",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "User login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginSuccessResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid payload or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Current user profile",
        "responses": {
          "200": {
            "description": "Authenticated profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/trade-categories": {
      "get": {
        "summary": "List active trade categories (Teranga Pro)",
        "responses": {
          "200": {
            "description": "Active trade categories",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TradeCategoryListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/providers": {
      "post": {
        "summary": "Submit a provider application (role 'provider' only)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProviderRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Provider profile created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid payload",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "403": {
            "description": "Caller is not a provider-role account",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List providers within the caller's scope (admin, category_manager)",
        "responses": {
          "200": {
            "description": "Scoped provider list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderListResponse"
                }
              }
            }
          },
          "403": {
            "description": "Caller has no manageable scope",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/providers/{id}/status": {
      "patch": {
        "summary": "Update provider account lifecycle status (category_manager, admin)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProviderStatusRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated provider account; Mobility ride readiness is returned separately when applicable",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProviderResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid status transition",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "403": {
            "description": "Caller does not manage this provider (scope mismatch)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "Provider not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/providers/{id}/contracts": {
      "post": {
        "summary": "Register a signed partnership contract (category_manager, admin)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProviderContractRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Contract created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderContractResponse"
                }
              }
            }
          },
          "403": {
            "description": "Caller does not manage this provider (scope mismatch)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "Provider not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/missions/estimate": {
      "post": {
        "summary": "Compute an indicative price/delay estimate for a guided mission (role: client)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MissionEstimateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Estimate",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MissionEstimateResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid category selection",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/missions": {
      "post": {
        "summary": "Create a guided mission for the authenticated client (role: client)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateMissionRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Mission created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MissionResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid payload or unresolvable address",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/missions/{id}/attachments": {
      "post": {
        "summary": "Attach an optional photo and/or voice note to a mission (owner client only)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "photo": { "type": "string", "format": "binary" },
                  "voiceNote": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Attachments created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MissionAttachmentsResponse" }
              }
            }
          },
          "403": {
            "description": "Caller does not own this mission",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "Mission not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/missions/{id}/assign": {
      "post": {
        "summary": "Manually assign a provider to a mission (admin only, manual assignment — auto-matching remains Lot 4)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AssignMissionRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Provider assigned, mission transitioned to ASSIGNED",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MissionActionResponse" }
              }
            }
          },
          "400": {
            "description": "Mission not assignable in its current state, or provider invalid/inactive/wrong trade category",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          },
          "403": {
            "description": "Mission outside caller's geographic scope",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          }
        }
      }
    },
    "/missions/{id}/status": {
      "patch": {
        "summary": "Transition mission status (section 2 state machine); allowed transitions depend on caller role",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateMissionStatusRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated mission",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MissionActionResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid transition, or mission has no missionStatus (classic agent flow)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          },
          "403": {
            "description": "Caller is not allowed to trigger this transition",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          }
        }
      }
    },
    "/missions/{id}/location": {
      "post": {
        "summary": "Ping the assigned executor's current position (role: agent, provider)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MissionLocationPingRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Position recorded",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/MissionLocationPingResponse" } }
            }
          },
          "400": {
            "description": "Mission not in an active execution window",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          },
          "403": {
            "description": "Caller is not the assigned executor",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          }
        }
      }
    },
    "/missions/{id}/track": {
      "get": {
        "summary": "Live tracking feed for the mission owner (role: client) — status, latest position, ETA",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Tracking snapshot",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/MissionTrackResponse" } }
            }
          },
          "403": {
            "description": "Caller does not own this mission",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          }
        }
      }
    },
    "/saved-locations": {
      "get": {
        "summary": "List the authenticated client's saved locations (role: client)",
        "responses": {
          "200": {
            "description": "Saved locations",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SavedLocationListResponse" }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Save a favorite location (role: client)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateSavedLocationRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Saved location created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SavedLocationResponse" }
              }
            }
          }
        }
      }
    },
    "/mission-pricing-rules": {
      "get": {
        "summary": "List pricing rules within the caller's scope (admin, global or country/region-scoped)",
        "responses": {
          "200": {
            "description": "Scoped pricing rules",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MissionPricingRuleListResponse" }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a pricing rule (admin, global or country/region-scoped)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateMissionPricingRuleRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pricing rule created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MissionPricingRuleResponse" }
              }
            }
          },
          "403": {
            "description": "Caller has no manageable scope for this country/region",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": [
          "ok",
          "ts"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "ts": {
            "type": "number"
          }
        },
        "additionalProperties": true
      },
      "ReadinessResponse": {
        "type": "object",
        "required": [
          "ok",
          "ts",
          "checks"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "ts": {
            "type": "number"
          },
          "checks": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "password"
        ],
        "properties": {
          "identifier": {
            "type": "string",
            "description": "Phone number or email address"
          },
          "email": {
            "type": "string",
            "description": "Backward-compatible login identifier. May contain an email address or phone number."
          },
          "phone": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      },
      "UserSummary": {
        "type": "object",
        "required": [
          "id",
          "role"
        ],
        "properties": {
          "id": {
            "type": "number"
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          },
          "firstName": {
            "type": [
              "string",
              "null"
            ]
          },
          "lastName": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": "string"
          },
          "countryId": {
            "type": [
              "number",
              "null"
            ]
          },
          "regionId": {
            "type": [
              "number",
              "null"
            ]
          },
          "language": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "LoginSuccessResponse": {
        "type": "object",
        "required": [
          "message",
          "token",
          "csrfToken",
          "user"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "csrfToken": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserSummary"
          }
        },
        "additionalProperties": true
      },
      "ValidationErrorDetail": {
        "type": "object",
        "required": [
          "message",
          "path",
          "type"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "LoginErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationErrorDetail"
            }
          }
        },
        "additionalProperties": true
      },
      "MeResponse": {
        "type": "object",
        "required": [
          "user"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserSummary"
          }
        },
        "additionalProperties": true
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "TradeCategory": {
        "type": "object",
        "required": ["id", "name", "slug"],
        "properties": {
          "id": { "type": "number" },
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "requiresCompany": { "type": "boolean" },
          "defaultWarrantyDays": { "type": "number" },
          "isActive": { "type": "boolean" }
        },
        "additionalProperties": true
      },
      "TradeCategoryListResponse": {
        "type": "object",
        "required": ["tradeCategories"],
        "properties": {
          "tradeCategories": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TradeCategory" }
          }
        },
        "additionalProperties": true
      },
      "Provider": {
        "type": "object",
        "required": ["id", "userId", "type", "displayFirstName", "status"],
        "properties": {
          "id": { "type": "number" },
          "userId": { "type": "number" },
          "type": { "type": "string", "enum": ["independent", "company"] },
          "legalName": { "type": ["string", "null"] },
          "displayFirstName": { "type": "string" },
          "rccmNumber": { "type": ["string", "null"] },
          "phoneNumber": { "type": "string" },
          "email": { "type": ["string", "null"] },
          "countryCode": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["pending", "probation", "active", "suspended", "revoked"]
          },
          "averageRating": { "type": ["number", "null"] },
          "completedMissionsCount": { "type": "number" },
          "hasLiabilityInsurance": { "type": "boolean" },
          "badgeCertified": { "type": "boolean" }
        },
        "additionalProperties": true
      },
      "ProviderResponse": {
        "type": "object",
        "required": ["provider"],
        "properties": {
          "provider": { "$ref": "#/components/schemas/Provider" },
          "mobilityActivation": {
            "type": "object",
            "required": ["accountActive", "dispatchReady", "compliance"],
            "properties": {
              "accountActive": { "type": "boolean" },
              "dispatchReady": { "type": "boolean" },
              "compliance": { "type": "object", "additionalProperties": true }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      },
      "ProviderListResponse": {
        "type": "object",
        "required": ["providers", "pagination"],
        "properties": {
          "providers": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Provider" }
          },
          "pagination": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "CreateProviderRequest": {
        "type": "object",
        "required": ["type", "displayFirstName", "phoneNumber", "countryCode", "tradeCategoryIds"],
        "properties": {
          "type": { "type": "string", "enum": ["independent", "company"] },
          "legalName": { "type": "string" },
          "displayFirstName": { "type": "string" },
          "rccmNumber": { "type": "string" },
          "phoneNumber": { "type": "string" },
          "email": { "type": "string" },
          "countryCode": { "type": "string", "minLength": 2, "maxLength": 2 },
          "hasLiabilityInsurance": { "type": "boolean" },
          "insuranceExpiresAt": { "type": "string", "format": "date" },
          "tradeCategoryIds": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 1
          }
        },
        "additionalProperties": false
      },
      "UpdateProviderStatusRequest": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["pending", "probation", "active", "suspended", "revoked"]
          }
        },
        "additionalProperties": false
      },
      "ProviderContract": {
        "type": "object",
        "required": ["id", "providerId", "commissionRate", "signedAt", "status"],
        "properties": {
          "id": { "type": "number" },
          "providerId": { "type": "number" },
          "commissionRate": { "type": "number" },
          "nonCircumventionMonths": { "type": "number" },
          "signedAt": { "type": "string", "format": "date-time" },
          "documentUrl": { "type": ["string", "null"] },
