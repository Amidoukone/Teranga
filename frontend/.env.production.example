NODE_ENV=production

# API endpoints
REACT_APP_API_URL=https://api.example.com/api
REACT_APP_API_BASE_URL=https://api.example.com/api
REACT_APP_FILE_BASE_URL=https://api.example.com

# Security posture
REACT_APP_AUTH_STORAGE=cookie
REACT_APP_COOKIE_BEARER_FALLBACK=false
REACT_APP_ENABLE_FRONTEND_ERROR_REPORTING=true
REACT_APP_OBSERVABILITY_TOKEN=replace-with-frontend-error-token

# Release metadata
REACT_APP_RELEASE=2026.03.07
