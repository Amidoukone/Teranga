NODE_ENV=production

# API endpoints
REACT_APP_API_URL=https://teranga-backend.onrender.com/api
REACT_APP_API_BASE_URL=https://teranga-backend.onrender.com/api
REACT_APP_FILE_BASE_URL=https://teranga-backend.onrender.com

# Security posture
REACT_APP_AUTH_STORAGE=cookie
REACT_APP_COOKIE_BEARER_FALLBACK=false
REACT_APP_ENABLE_FRONTEND_ERROR_REPORTING=true
REACT_APP_OBSERVABILITY_TOKEN=replace-with-frontend-error-token

# Google Maps Platform (browser: Maps JavaScript API, Places API)
# Restricted by HTTP referrer in Google Cloud Console (teranga-diaspora.com) — never the server key.
REACT_APP_GOOGLE_MAPS_BROWSER_KEY=

# Release metadata
REACT_APP_RELEASE=2026.06.25
