# --- Dépendances ---
node_modules/

# --- Caches et builds temporaires ---
.cache/
dist/
build/
tmp/
playwright-report/
test-results/

# --- Fichiers de logs ---
*.log

# --- Fichiers d'environnement (ne pas exposer les clés secrètes) ---
.env
.env.local
.env.*
!.env.example
!.env.*.example

# --- Fichiers système inutiles ---
.DS_Store
Thumbs.db

# --- Fichiers uploades runtime (ne pas versionner) ---
backend/uploads/

# --- Backups texte/mojibake (hors code actif) ---
*.bak*
archive/mojibake/

# --- Outils et dumps de migration DB locaux ---
tools/migration/
backups/
*.sql
*.sql.gz
*.dump
*.dump.gz
*.backup

# --- Certificats, cles et secrets locaux ---
*.crt
*.cer
*.pem
*.key
*.p12
*.pfx
